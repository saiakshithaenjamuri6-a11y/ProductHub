# ==========================================
# ProductHub Environment Configuration
# ==========================================

# Server Port
PORT=5000

# Environment Mode (development | production)
NODE_ENV=development

# MongoDB Connection String
# For local MongoDB daemon:
MONGODB_URI=mongodb://127.0.0.1:27017/producthub

# For MongoDB Atlas (cloud cluster):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/producthub?retryWrites=true&w=majority
